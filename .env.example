# Frontend Environment Variables
# Copy this file to .env or .env.local and update the values

# ─ Development ────────────────────────────────────────
# Backend running locally on port 5000
VITE_API_URL=http://localhost:5000/api/v1
VITE_SOCKET_URL=http://localhost:5000

# ─ Docker (with docker-compose) ───────────────────────
# Backend service accessible via 'backend' hostname
# VITE_API_URL=http://backend:5000/api/v1
# VITE_SOCKET_URL=http://backend:5000

# ─ Production ─────────────────────────────────────────
# Your production backend domain
# VITE_API_URL=https://api.example.com/api/v1
# VITE_SOCKET_URL=https://api.example.com

# ─ Notes ──────────────────────────────────────────────
# - VITE_ prefix makes variables available in browser (window.__vite_env__)
# - Do NOT commit sensitive data to .env files
# - Use .env.local for local overrides (gitignored)
# - For Docker: set via -e flag or environment section in docker-compose.yml
